+@pytest.mark.parametrize("dynamic", [True, False])
+def test_native_quota_protocol_and_original_incumbent_send(monkeypatch, dynamic):
+    bridge = _PersistentNativeSolver()
+    bridge._process = SimpleNamespace(poll=lambda: None, stdin=object())
+    bridge._lines = queue.Queue()
+    bridge._dynamic_threads = dynamic
+    sent, events = [], []
+    counts = iter([2, 3])
+
+    def send(message):
+        sent.append(message)
+        if message.startswith("solve\t"):
+            request_id = message.split("\t")[1]
+            bridge._lines.put(json.dumps({"type": "result", "request_id": request_id, "ok": True}))
+
+    monkeypatch.setattr(bridge, "_send_locked", send)
+    bridge.solve(CubieCube(), 20, 1, 2, None, None, None, incumbent_provider=lambda: ["R", "R'"],
+                 event_callback=events.append, threads_provider=lambda: next(counts))
+    assert sent[0].startswith("solve\t") and sent[0].endswith("\t2\t\n")
+    assert sent[1].startswith("incumbent\t") and sent[1].endswith("\tR R'\n")
+    assert any(item["type"] == "native_incumbent_sent" for item in events)
+    assert len(sent) == (3 if dynamic else 2)
+    if dynamic:
+        assert sent[2].startswith("threads\t") and sent[2].endswith("\t3\n")
