+    monkeypatch.setattr(server, "QUICK_OPTIMAL_PROBE_SECONDS", 0.005)
+    monkeypatch.setattr(server, "native_solver_available", lambda: True)
+    generated, release, finish_proof = threading.Event(), threading.Event(), threading.Event()
+
+    def fast(cube, *, timeout_seconds, observation_callback):
+        observation_callback(candidate(["R'", "U", "U'"]))
+        generated.set()
+        assert release.wait(2)
+        return candidate(["R'"])
+
+    def native(cube, **kwargs):
+        assert finish_proof.wait(2)
+        return {"moves": ["R'"], "solution": "R'", "depth": 1, "metric": "HTM", "optimal": True}
+
+    monkeypatch.setattr(server.FAST_SOLVER, "solve_cube", fast)
+    monkeypatch.setattr(server, "solve_native", native)
+    response = []
+    sender = threading.Thread(target=lambda: response.append(request_solve(http,
+        CubieCube().apply_move_index(MOVE_INDEX["R"]))), daemon=True)
+    sender.start()
+    try:
+        assert generated.wait(1)
+        job = next(iter(server.JOBS.values()))
+        finish_proof.set()
+        for _ in range(100):
+            if job["terminal_seconds"] is not None:
+                break
+            threading.Event().wait(0.005)
+        terminal = job["terminal_seconds"]
+        assert terminal is not None and job["status"] == "complete"
+        assert not job["_done"].is_set() and not response
+        release.set()
+        sender.join(2)
+        assert response[0]["terminal_seconds"] == terminal
+        assert response[0]["proof_status"] == "complete"
+        assert job["_done"].wait(1)
+        assert job["http_return_seconds"] >= terminal
+    finally:
+        release.set()
+        finish_proof.set()
+        sender.join(2)
+
