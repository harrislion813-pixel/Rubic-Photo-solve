+@pytest.mark.parametrize("threads", [1, 2, 3, 15])
+def test_http_retains_synchronous_candidate_and_shares_quota(jobs, http, monkeypatch, threads):
+    monkeypatch.setattr(server, "BROKER", ResourceBroker(threads))
+    monkeypatch.setattr(server, "QUICK_OPTIMAL_PROBE_SECONDS", 0.005)
+    monkeypatch.setattr(server, "native_solver_available", lambda: True)
+    generated, release, proof_started = threading.Event(), threading.Event(), threading.Event()
+    proof_calls = []
+
+    def fast(cube, *, timeout_seconds, observation_callback):
+        assert 0 < timeout_seconds <= server.QUICK_SOLVE_SECONDS
+        observation_callback(candidate(["R'", "U", "U'"]))
+        generated.set()
+        assert release.wait(2)
+        result = candidate(["R'"])
+        observation_callback(result)
+        return result
+
+    def native(cube, **kwargs):
+        proof_calls.append(kwargs)
+        proof_started.set()
+        while not kwargs["cancel_event"].wait(0.01):
+            pass
+        raise NativeSolverCancelled("cancelled")
+
+    monkeypatch.setattr(server.FAST_SOLVER, "solve_cube", fast)
+    monkeypatch.setattr(server, "solve_native", native)
+    response, errors = [], []
+
+    def send():
+        try:
+            response.append(request_solve(http, CubieCube().apply_move_index(MOVE_INDEX["R"])))
+        except Exception as exc:
+            errors.append(exc)
+
+    sender = threading.Thread(target=send, daemon=True)
+    sender.start()
+    try:
+        assert generated.wait(1)
+        assert not response and not errors
+        job = next(iter(server.JOBS.values()))
+        assert job["first_candidate_generated_seconds"] is not None
+        assert job["candidate_published_seconds"] is None
+        assert job["_incumbent_moves"] is None
+        assert proof_started.is_set() == (threads > 1)
+        assert job["_proof_threads"] == max(1, threads - 1)
+        release.set()
+        sender.join(2)
+        assert not sender.is_alive() and not errors
+        assert response[0]["depth"] == 1 and not response[0]["optimal"]
+        assert proof_started.wait(1)
+        call = proof_calls[0]
+        assert call["threads"] == max(1, threads - 1)
+        assert call["deadline"] == job["_deadline"]
+        assert call["incumbent_provider"]() == ["R'"]
+        assert call["threads_provider"]() == threads
+        assert job["candidate_published_seconds"] >= job["first_candidate_generated_seconds"]
+        assert [item["cost"] for item in job["candidate_observations"]] == [3, 1]
+        job["_cancel_event"].set()
+        assert job["_done"].wait(1)
+        assert job["terminal_seconds"] is not None
+        assert call["threads_provider"]() is None
+        sent = []
+        assert not call["threads_update_guard"](lambda: sent.append(True)) and not sent
+    finally:
+        release.set()
+        sender.join(2)
