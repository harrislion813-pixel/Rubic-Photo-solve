+def request_solve(url, cube):
+    request = Request(url + "/api/solve", data=json.dumps({"facelets": to_facelets(cube),
+                      "timeout_seconds": 5}).encode(), headers={"Content-Type": "application/json"})
+    with urlopen(request, timeout=3) as response:
+        return json.loads(response.read())
