+    yield
+    with server.JOBS_LOCK:
+        created = list(server.JOBS.values())
+        for job in created:
+            job["_cancel_event"].set()
+            job["_candidate_budget_done"].set()
+    for job in created:
+        if job["_worker"].ident is not None:
+            job["_worker"].join(2)
