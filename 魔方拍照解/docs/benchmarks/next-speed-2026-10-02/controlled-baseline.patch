+def test_fast_observation_retains_original_search_ast():
+    class StripObservation(ast.NodeTransformer):
+        def visit_ImportFrom(self, node):
+            return None if node.module == "collections.abc" else node
+
+        def visit_FunctionDef(self, node):
+            if node.name == "observe":
+                return None
+            node.args.kwonlyargs = [arg for arg in node.args.kwonlyargs if arg.arg != "observation_callback"]
+            node.args.kw_defaults = node.args.kw_defaults[:len(node.args.kwonlyargs)]
+            if node.args.args and node.args.args[-1].arg == "observation_callback":
+                node.args.args.pop()
+                node.args.defaults.pop()
+            return self.generic_visit(node)
+
+        def visit_Expr(self, node):
+            call = node.value
+            if isinstance(call, ast.Call) and isinstance(call.func, ast.Name) and call.func.id == "observe":
+                return None
+            return self.generic_visit(node)
+
+        def visit_If(self, node):
+            if ast.unparse(node.test) == "observation_callback is not None":
+                return None
+            return self.generic_visit(node)
+
+        def visit_Call(self, node):
+            node.keywords = [kw for kw in node.keywords if kw.arg != "observation_callback"]
+            if isinstance(node.func, ast.Attribute) and node.func.attr == "_improve_phase1":
+                if isinstance(node.args[-1], ast.Name) and node.args[-1].id in {"observe", "observation_callback"}:
+                    node.args.pop()
+            return self.generic_visit(node)
+
+    root = Path(server.__file__).resolve().parent
+    relative = "cube_app/solvers/htm/fast.py"
+    frozen = ast.parse((root.parent / "baseline" / relative).read_text(encoding="utf-8"))
+    observed = StripObservation().visit(ast.parse((root / relative).read_text(encoding="utf-8")))
+    assert ast.dump(observed, include_attributes=False) == ast.dump(frozen, include_attributes=False)
+
+
+def test_fast_observation_records_first_and_improvement_without_early_return():
+    seen = []
+
+    class SyntheticFast(FastTwoPhaseSolver):
+        @staticmethod
+        def _phase1_heuristic(*args):
+            return 0
+
+        def _search_phase1(self, *args):
+            return [MOVE_INDEX[name] for name in ("R'", "U", "U'")]
+
+        def _improve_phase1(self, *args):
+            holder, notify = args[-3], args[-1]
+            assert seen == [3]
+            holder[0] = [MOVE_INDEX["R'"]]
+            notify(holder[0])
+            assert seen == [3, 1]
+            raise SearchTimeout("original improvement budget ends")
+
+    result = SyntheticFast(tables=SimpleNamespace(), max_phase1_depth=0).solve_cube(
+        CubieCube().apply_move_index(MOVE_INDEX["R"]), observation_callback=lambda item: seen.append(item.depth))
+    assert seen == [3, 1] and result.depth == 1
+
