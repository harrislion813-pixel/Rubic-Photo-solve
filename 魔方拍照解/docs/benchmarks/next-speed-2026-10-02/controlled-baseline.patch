+def test_qtm_native_observation_retains_original_ast():
+    class StripTerminalObservation(ast.NodeTransformer):
+        def visit_Assign(self, node):
+            if ast.unparse(node.targets[0]) == "event['client_terminal_at']":
+                return None
+            return self.generic_visit(node)
+
+        def visit_If(self, node):
+            if (ast.unparse(node.test) == "progress_callback is not None"
+                    and any(isinstance(item, ast.Constant) and item.value == "native_result" for item in ast.walk(node))):
+                return None
+            return self.generic_visit(node)
+
+        def visit_Dict(self, node):
+            pairs = [(key, value) for key, value in zip(node.keys, node.values)
+                     if not (isinstance(key, ast.Constant) and key.value == "client_terminal_at")]
+            node.keys = [pair[0] for pair in pairs]
+            node.values = [pair[1] for pair in pairs]
+            return self.generic_visit(node)
+
+    root = Path(server.__file__).resolve().parent
+    path = "cube_app/solvers/qtm/native.py"
+    frozen = ast.parse((root.parent / "baseline" / path).read_text(encoding="utf-8"))
+    observed = StripTerminalObservation().visit(ast.parse((root / path).read_text(encoding="utf-8")))
+    assert ast.dump(frozen, include_attributes=False) == ast.dump(observed, include_attributes=False)
+
