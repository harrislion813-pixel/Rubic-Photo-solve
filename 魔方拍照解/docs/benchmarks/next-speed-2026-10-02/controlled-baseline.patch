+def test_cancelled_unbounded_queue_wait_does_not_start_candidate(jobs, monkeypatch):
+    monkeypatch.setattr(server, "BROKER", ResourceBroker(3))
+    monkeypatch.setattr(server, "QUICK_OPTIMAL_PROBE_SECONDS", 0.005)
+    monkeypatch.setattr(server, "native_solver_available", lambda: True)
+    monkeypatch.setattr(server.FAST_SOLVER, "solve_cube", lambda *a, **kw: pytest.fail("unleased candidate ran"))
+    cube = CubieCube().apply_move_index(MOVE_INDEX["R"])
+    first_id, first_worker = server.prepare_optimal_job(cube, None, 20, None, candidate_enabled=True)
+    job = server.JOBS[first_id]
+    job["_cancel_event"].set()
+    job["status"] = "cancelled"
+    assert not job["_proof_lease"].is_set()
+    # Exercise the HTTP lease wait after it took a queued snapshot and before cancellation.
+    class FakeDone:
+        def wait(self, timeout):
+            return False
+
+    handler = object.__new__(server.AppHandler)
+    handler.path = "/api/solve"
+    handler._read_json = lambda: {"facelets": to_facelets(cube), "timeout_seconds": None}
+    captured = []
+    handler._send_json = lambda payload, status=200: captured.append(payload)
+    monkeypatch.setattr(server, "prepare_optimal_job", lambda *a, **kw: (first_id, first_worker))
+    monkeypatch.setattr(server, "start_optimal_job", lambda *a: None)
+
+    # Snapshot is deliberately running; FakeDone cancels exactly before the lease wait.
+    job["status"] = "queued"
+    class CancellingLease:
+        def wait(self, timeout):
+            job["_cancel_event"].set()
+            job["status"] = "cancelled"
+            return False
+
+    job["_done"] = FakeDone()
+    job["_proof_lease"] = CancellingLease()
+    handler.do_POST()
+    assert captured[0]["proof_status"] == "cancelled"
+    assert job["_candidate_budget_done"].is_set()
+
