+def test_queued_candidate_waits_for_its_job_proof_lease(jobs, http, monkeypatch):
+    monkeypatch.setattr(server, "BROKER", ResourceBroker(3))
+    monkeypatch.setattr(server, "QUICK_OPTIMAL_PROBE_SECONDS", 0.005)
+    monkeypatch.setattr(server, "native_solver_available", lambda: True)
+    first = CubieCube().apply_move_index(MOVE_INDEX["R"])
+    second = CubieCube().apply_move_index(MOVE_INDEX["U"])
+    started = [threading.Event(), threading.Event()]
+    observations = []
+
+    def native(cube, **kwargs):
+        started[int(cube == second)].set()
+        while not kwargs["cancel_event"].wait(0.01):
+            pass
+        raise NativeSolverCancelled("cancelled")
+
+    def fast(cube, **kwargs):
+        observations.append(cube)
+        result = candidate(["R'"] if cube == first else ["U'"])
+        kwargs["observation_callback"](result)
+        return result
+
+    monkeypatch.setattr(server, "solve_native", native)
+    monkeypatch.setattr(server.FAST_SOLVER, "solve_cube", fast)
+    first_response = request_solve(http, first)
+    first_job = server.JOBS[first_response["job_id"]]
+    assert started[0].is_set() and first_job["_candidate_budget_done"].is_set()
+    second_response = []
+    sender = threading.Thread(target=lambda: second_response.append(request_solve(http, second)), daemon=True)
+    sender.start()
+    try:
+        for _ in range(100):
+            if len(server.JOBS) == 2 and any(job.get("_generator_started") for job in server.JOBS.values()
+                                               if job is not first_job):
+                break
+            threading.Event().wait(0.005)
+        second_job = next(job for job in server.JOBS.values() if job is not first_job)
+        assert not second_job["_proof_lease"].is_set() and observations == [first]
+        assert not second_response and not started[1].is_set()
+        first_job["_cancel_event"].set()
+        assert first_job["_done"].wait(1)
+        assert started[1].wait(1)
+        sender.join(2)
+        assert not sender.is_alive() and second_response[0]["depth"] == 1
+        assert observations == [first, second]
+        second_job["_cancel_event"].set()
+        assert second_job["_done"].wait(1)
+    finally:
+        for job in server.JOBS.values():
+            job["_cancel_event"].set()
+        sender.join(2)
+
